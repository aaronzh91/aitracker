{
  "$id": "bottleneck.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Money Tracker supply-chain bottleneck record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "group", "status", "description_md", "controlled_by", "dependents", "sources", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "name": { "type": "string", "minLength": 3 },
    "group": { "type": "string", "enum": ["compute_supply_chain", "physical_infrastructure", "energy", "labor", "land_permits"] },
    "status": { "type": "string", "enum": ["binding", "easing", "watch", "resolved"] },
    "description_md": { "type": "string", "minLength": 20, "description": "What it is and why it constrains the whole chain, plain language" },
    "controlled_by": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity"],
        "properties": {
          "entity": { "type": "string" },
          "share_note": { "type": "string", "description": "Market/capacity share with basis, e.g. '~60% HBM share (press_reported)'" }
        }
      }
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity", "dependency_md"],
        "properties": {
          "entity": { "type": "string" },
          "dependency_md": { "type": "string" }
        }
      }
    },
    "substitutes_md": { "type": "string" },
    "downcycle_md": { "type": "string" },
    "observations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/observation" } },
    "events": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/event" } },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source" } },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
