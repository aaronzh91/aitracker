---
import Base from "../layouts/Base.astro";
import { readFileSync } from "node:fs";
const log = JSON.parse(readFileSync(new URL("../../../data/changelog.json", import.meta.url), "utf8"));
---
<Base title="Changelog — AI Money Tracker">
  <div class="narrow">
    <h1>Changelog</h1>
    <p class="lede">One entry per update run (weekly, Saturdays 8pm ET), plus out-of-band corrections. "No material changes"
      weeks are recorded too — silence should be distinguishable from staleness. Full detail lives in the
      <a href="https://github.com/aaronzh91/aitracker/commits/main">git history</a>.</p>
    {log.map((entry) => (
      <div class="panel" style="margin-bottom:12px">
        <h3 style="margin-bottom:4px">{entry.date} — {entry.title} {entry.kind === "mechanical" && <span class="chip dim">Automated</span>}</h3>
        <p style="margin:0">{entry.body}</p>
      </div>
    ))}
  </div>
</Base>
