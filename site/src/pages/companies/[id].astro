---
import Base from "../../layouts/Base.astro";
import { entities, entityById, edgesFor, latestObs, fmtMoney, fmtObsValue, label, GROUP_LABELS, TYPE_LABELS } from "../../lib/data.js";

export function getStaticPaths() {
  return entities.map((e) => ({ params: { id: e.id } }));
}
const { id } = Astro.params;
const e = entityById[id];
const cap = latestObs(e, ["market_cap", "valuation"]);
const { outbound, inbound } = edgesFor(id);
const dead = (r) => ["dead", "cancelled", "withdrawn", "failed"].includes(r.status);
const events = [...(e.events ?? [])].sort((a, b) => (a.date < b.date ? 1 : -1));
const ghUrl = `https://github.com/aaronzh91/aitracker/blob/main/data/entities/${e.id}.json`;
---
<Base title={`${e.name} — AI Money Tracker`} description={e.monetization}>
  <h1>{e.name}</h1>
  <p>
    <span class="chip">{GROUP_LABELS[e.group]}</span>
    <span class="chip dim">{label(e.category)}</span>
    <span class="chip dim">Coverage: Tier {e.tier}</span>
    {e.tickers?.map((t) => <span class="chip dim">{t.exchange}: {t.symbol}</span>)}
    {cap && <span class="chip warn">{e.kind === "public_company" ? "Mkt cap" : "Valuation"} {fmtMoney(cap)} <span class={`basis ${cap.basis}`}>{cap.basis[0].toUpperCase()}</span></span>}
  </p>
  <p class="lede">{e.monetization}</p>

  {e.description_md && (<section class="prose"><h2>Business</h2><p>{e.description_md}</p></section>)}
  {e.ai_monetization_md && (<section class="prose"><h2>How it monetizes AI</h2><p>{e.ai_monetization_md}</p></section>)}
  {e.ai_strategy_md && (<section class="prose"><h2>AI strategy</h2><p>{e.ai_strategy_md}</p></section>)}
  {e.risk_notes_md && (<section class="prose"><h2>Risk notes</h2><p>{e.risk_notes_md}</p></section>)}

  {(e.observations ?? []).length > 0 && (
    <section>
      <h2>Key financials & metrics</h2>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Metric</th><th>Period</th><th class="num">Value</th><th>Basis</th><th>Confidence</th><th>Source</th><th>Notes</th></tr></thead>
          <tbody>
            {e.observations.map((o) => (
              <tr>
                <td>{o.metric_label ?? label(o.metric)}</td>
                <td>{o.period}</td>
                <td class="num"><strong>{fmtObsValue(o)}</strong></td>
                <td><span class={`basis ${o.basis}`}>{label(o.basis)}</span>{o.method_md && <div class="src">Method: {o.method_md}</div>}</td>
                <td>{label(o.confidence)}</td>
                <td class="src"><a href={o.source.url}>{o.source.publisher}</a></td>
                <td class="src">{o.notes ?? ""}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section id="flows">
    <h2>Money flows</h2>
    <div class="grid2">
      <div class="panel">
        <h3>Outbound (this company pays)</h3>
        {outbound.length === 0 && <p class="src">None recorded yet.</p>}
        {outbound.map((r) => (
          <p style="margin:6px 0">
            <a href={`/flows/${r.id}`}><strong>→ {entityById[r.to]?.name ?? r.to}</strong></a>
            {" "}<span class="chip dim">{TYPE_LABELS[r.type]}</span> {fmtMoney(r.headline)}
            {dead(r) && <span class="chip bad">{label(r.status)}</span>}
          </p>
        ))}
      </div>
      <div class="panel">
        <h3>Inbound (this company is paid)</h3>
        {inbound.length === 0 && <p class="src">None recorded yet.</p>}
        {inbound.map((r) => (
          <p style="margin:6px 0">
            <a href={`/flows/${r.id}`}><strong>← {entityById[r.from]?.name ?? r.from}</strong></a>
            {" "}<span class="chip dim">{TYPE_LABELS[r.type]}</span> {fmtMoney(r.headline)}
            {dead(r) && <span class="chip bad">{label(r.status)}</span>}
          </p>
        ))}
      </div>
    </div>
  </section>

  {events.length > 0 && (
    <section>
      <h2>Key developments</h2>
      {events.map((ev) => (
        <div class="panel" style="margin-bottom:10px">
          <strong>{ev.date}</strong> — {ev.title} {ev.impact === "high" && <span class="chip warn">High impact</span>}
          {ev.why_it_matters && <p style="margin:4px 0 0">{ev.why_it_matters}</p>}
          <p class="src" style="margin:4px 0 0">{ev.sources.map((s, i) => <span>{i > 0 && " · "}<a href={s.url}>{s.publisher}</a></span>)}</p>
        </div>
      ))}
    </section>
  )}

  <p class="updated">
    Updated {e.updated} · <a href={ghUrl}>view this record's data & history on GitHub</a> ·
    <a href="https://github.com/aaronzh91/aitracker/issues/new?template=data-error.md">report an error</a>
  </p>
</Base>
