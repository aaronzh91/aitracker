---
import Base from "../../layouts/Base.astro";
import { relationships, relById, entityById, bottlenecks, fmtMoney, label, TYPE_LABELS, FLAG_LABELS } from "../../lib/data.js";

export function getStaticPaths() {
  return relationships.map((r) => ({ params: { id: r.id } }));
}
const { id } = Astro.params;
const r = relById[id];
const payer = entityById[r.from];
const payee = entityById[r.to];
const dead = ["dead", "cancelled", "withdrawn", "failed"].includes(r.status);
const events = [...(r.events ?? [])].sort((a, b) => (a.date < b.date ? 1 : -1));
const ghUrl = `https://github.com/aaronzh91/aitracker/blob/main/data/relationships/${r.id}.json`;
---
<Base title={`${payer?.name ?? r.from} → ${payee?.name ?? r.to} — AI Money Tracker`}>
  <h1><a href={`/companies/${r.from}`}>{payer?.name ?? r.from}</a> <span class="flow-dir">→</span> <a href={`/companies/${r.to}`}>{payee?.name ?? r.to}</a></h1>
  <p>
    <span class="chip">{TYPE_LABELS[r.type]}</span>
    {dead ? <span class="chip bad">{label(r.status)}</span> : <span class="chip dim">{label(r.status)}</span>}
    {(r.accounting?.flags ?? []).map((f) => <span class="chip warn">{FLAG_LABELS[f] ?? f}</span>)}
    {r.accounting?.off_balance_sheet && <span class="chip warn">Off balance sheet</span>}
  </p>

  <div class="statrow">
    <div class="stat"><div class="n">{fmtMoney(r.headline)}</div><div class="l">headline / committed{r.headline?.caveat ? ` (${r.headline.caveat})` : ""}</div></div>
    <div class="stat"><div class="n">{r.realized_to_date ? fmtMoney(r.realized_to_date) : "unknown"}</div><div class="l">realized to date</div></div>
    {r.annualized_flow && <div class="stat"><div class="n">{fmtMoney(r.annualized_flow)}</div><div class="l">annualized flow</div></div>}
    {r.term?.announced && <div class="stat"><div class="n">{r.term.announced}</div><div class="l">announced</div></div>}
    {r.term?.end && <div class="stat"><div class="n">{r.term.end}</div><div class="l">runs to</div></div>}
  </div>
  <p class="src">Headline values are announcements/commitments, not money that has moved. "Realized to date" is the best-sourced figure for actual transfers — "unknown" is itself information.</p>

  <section class="prose"><h2>Nature of the deal</h2><p>{r.nature_md}</p></section>

  <h2>Accounting treatment — both sides</h2>
  <div class="grid2">
    <div class="panel"><h3>Payer: {payer?.name ?? r.from}</h3><p>{r.accounting.payer_treatment_md}</p></div>
    <div class="panel"><h3>Payee: {payee?.name ?? r.to}</h3><p>{r.accounting.payee_treatment_md}</p></div>
  </div>

  {r.both_sides_md && (<section class="prose"><h2>Contested framing — both sides</h2><p>{r.both_sides_md}</p></section>)}

  {(r.related_edges ?? []).length > 0 && (
    <section>
      <h2>Related flows</h2>
      {r.related_edges.map((rel) => {
        const rr = relById[rel];
        return rr
          ? <p><a href={`/flows/${rel}`}>{entityById[rr.from]?.name ?? rr.from} → {entityById[rr.to]?.name ?? rr.to} · {TYPE_LABELS[rr.type]} · {fmtMoney(rr.headline)}</a></p>
          : <p class="src">{rel} (pending)</p>;
      })}
    </section>
  )}

  {(r.bottlenecks ?? []).length > 0 && (
    <section>
      <h2>Bottlenecks this flow transits</h2>
      {r.bottlenecks.map((b) => <p><a href={`/bottlenecks/${b}`}>{bottlenecks.find((x) => x.id === b)?.name ?? b}</a></p>)}
    </section>
  )}

  {events.length > 0 && (
    <section>
      <h2>Timeline</h2>
      {events.map((ev) => (
        <div class="panel" style="margin-bottom:10px">
          <strong>{ev.date}</strong> — {ev.title}
          {ev.why_it_matters && <p style="margin:4px 0 0">{ev.why_it_matters}</p>}
          <p class="src" style="margin:4px 0 0">{ev.sources.map((s, i) => <span>{i > 0 && " · "}<a href={s.url}>{s.publisher}</a></span>)}</p>
        </div>
      ))}
    </section>
  )}

  <section>
    <h2>Sources</h2>
    {r.sources.map((s) => <p class="src"><a href={s.url}>{s.publisher}{s.title ? ` — ${s.title}` : ""}</a>{s.published ? ` (${s.published})` : ""}</p>)}
  </section>

  <p class="updated">Updated {r.updated} · <a href={ghUrl}>data & history on GitHub</a> · <a href="https://github.com/aaronzh91/aitracker/issues/new?template=data-error.md">report an error</a></p>
</Base>
